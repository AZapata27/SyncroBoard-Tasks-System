{
  "name": "syncroboard-monorepo",
  "version": "1.0.0",
  "description": "SyncroBoard Tasks Management System - Monorepo",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "lint": "nx lint",
    "format": "nx format:write",
    "affected:test": "nx affected --target=test",
    "affected:build": "nx affected --target=build",
    "affected:lint": "nx affected --target=lint",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "dev:auth": "nx serve auth-service",
    "dev:gateway": "nx serve gateway",
    "dev:ticket": "nx serve ticket-service",
    "dev:assignment": "nx serve assignment-service",
    "dev:notification": "nx serve notification-service",
    "build:all": "nx run-many --target=build --all",
    "test:all": "nx run-many --target=test --all",
    "lint:all": "nx run-many --target=lint --all"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@nx/eslint": "22.7.9",
    "@nx/eslint-plugin": "22.7.9",
    "@nx/jest": "22.7.9",
    "@nx/js": "22.7.9",
    "@nx/nest": "22.7.9",
    "@nx/node": "22.7.9",
    "@nx/webpack": "22.7.9",
    "@nx/workspace": "22.7.9",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "^20.8.9",
    "@types/passport-jwt": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.0.5",
    "jest-environment-node": "30.0.5",
    "nx": "22.7.9",
    "prettier": "^3.0.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "typescript": "~5.2.2",
    "jest-util": "30.0.5"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.2.8",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.2.8",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.2.8",
    "@nestjs/platform-socket.io": "^10.2.8",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.2.8",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.2",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.17"
  }
}
